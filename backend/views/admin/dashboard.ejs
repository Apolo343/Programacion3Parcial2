<%- include('../partials/header', { titulo: 'Dashboard' }) %>

<div class="barra-titulo">
  <div>
    <h1>Panel de productos</h1>
    <p class="subtitulo">Productos separados por tipo. Los inactivos no se ven en la tienda.</p>
  </div>
  <a class="btn" href="/admin/productos/nuevo">+ Agregar producto</a>
</div>

<% if (mensaje) { %>
  <div class="aviso aviso--ok" role="status"><%= mensaje %></div>
<% } %>

<%# Recorremos las categorías: { perifericos: [...], almacenamiento: [...] } %>
<% Object.keys(porCategoria).forEach((clave) => { %>
  <% const lista = porCategoria[clave]; %>
  <h2><%= categorias[clave] %> (<%= lista.length %>)</h2>

  <div class="tabla-wrap">
    <% if (lista.length === 0) { %>
      <p class="vacio">No hay productos en esta categoría.</p>
    <% } else { %>
    <table class="apilable">
      <thead>
        <tr>
          <th>Imagen</th><th>ID</th><th>Nombre</th><th class="num">Precio</th><th>Estado</th><th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% lista.forEach((p) => { %>
          <tr class="<%= p.activo ? '' : 'fila-inactiva' %>">
            <td data-label="Imagen"><img class="miniatura" src="<%= p.imagen %>" alt="<%= p.nombre %>"></td>
            <td data-label="ID"><%= p.id %></td>
            <td data-label="Nombre">
              <strong><%= p.nombre %></strong>
            </td>
            <td data-label="Precio" class="num"><%= moneda(p.precio) %></td>
            <td data-label="Estado">
              <span class="badge <%= p.activo ? 'badge--activo' : 'badge--inactivo' %>">
                <%= p.activo ? 'Activo' : 'Inactivo' %>
              </span>
            </td>
            <td data-label="Acciones">
              <div class="acciones">
                <a class="btn btn--sec btn--chico" href="/admin/productos/<%= p.id %>/editar">Editar</a>
                <% if (p.activo) { %>
                  <button type="button" class="btn btn--peligro btn--chico js-confirmar"
                          data-accion="/admin/productos/<%= p.id %>/desactivar"
                          data-estilo="btn--peligro"
                          data-mensaje="¿Seguro que querés eliminar «<%= p.nombre %>»? Pasará a estado inactivo y dejará de verse en la tienda.">
                    Eliminar
                  </button>
                <% } else { %>
                  <button type="button" class="btn btn--ok btn--chico js-confirmar"
                          data-accion="/admin/productos/<%= p.id %>/reactivar"
                          data-estilo="btn--ok"
                          data-mensaje="¿Seguro que querés activar «<%= p.nombre %>»? Volverá a verse en la tienda.">
                    Activar
                  </button>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
<% }) %>

<%# MODAL de confirmación (consigna: "se muestra un modal que pregunta si está seguro") %>
<dialog id="modal-confirmar">
  <form method="POST" action="">
    <h3>Confirmar acción</h3>
    <p id="modal-mensaje"></p>
    <div class="acciones-form">
      <button type="button" id="modal-cancelar" class="btn btn--sec">Cancelar</button>
      <button type="submit" id="modal-confirmar-btn" class="btn btn--peligro">Confirmar</button>
    </div>
  </form>
</dialog>

<%- include('../partials/footer') %>

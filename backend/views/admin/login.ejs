<%- include('../partials/header', { titulo: 'Ingreso de administrador' }) %>

<section class="login tarjeta">
  <h1>Ingreso de administrador</h1>
  <p class="subtitulo" style="text-align:center">Ingresá con tu correo y contraseña</p>

  <% if (error) { %>
    <div class="aviso aviso--error" role="alert"><%= error %></div>
  <% } %>

  <%# novalidate: dejamos que la validación la haga el SERVIDOR y mostramos sus mensajes %>
  <form action="/admin/login" method="POST" novalidate>
    <div class="campo <%= errores.email ? 'con-error' : '' %>">
      <label for="email">Correo</label>
      <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" required>
      <% if (errores.email) { %><p class="error"><%= errores.email %></p><% } %>
    </div>

    <div class="campo <%= errores.password ? 'con-error' : '' %>">
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
      <% if (errores.password) { %><p class="error"><%= errores.password %></p><% } %>
    </div>

    <button type="submit" class="btn btn--bloque">Ingresar</button>
  </form>

  <%# BOTÓN DE ACCESO RÁPIDO (consigna 5.1): autocompleta los inputs para los testers %>
  <div class="acceso-rapido">
    <button type="button" id="acceso-rapido" class="btn btn--sec btn--bloque"
            data-email="<%= adminDemo.email %>" data-password="<%= adminDemo.password %>">
      ⚡ Acceso rápido (autocompletar)
    </button>
    <small>Solo para pruebas: completa los datos del administrador de demo.</small>
  </div>
</section>

<%- include('../partials/footer') %>
